rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'LAFASHOPCAMISAS@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPoll(data) {
      return data.keys().hasAll(['id', 'question', 'status', 'totalVotes', 'createdAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.question is string && data.question.size() <= 500 &&
             data.status in ['active', 'closed'] &&
             data.totalVotes is number &&
             data.createdAt is string; // or timestamp if using native
    }

    function isValidOption(data) {
      return data.keys().hasAll(['id', 'label', 'votes']) &&
             data.id is string && data.id.size() <= 128 &&
             data.label is string && data.label.size() <= 100 &&
             data.votes is number;
    }

    function isValidUserVote(data, pollId) {
      return data.keys().hasAll(['pollId', 'optionId', 'userId', 'timestamp']) &&
             data.pollId == pollId &&
             data.userId == request.auth.uid &&
             data.timestamp == request.time;
    }

    function isValidComment(data) {
      return data.keys().hasAll(['id', 'userId', 'userName', 'text', 'createdAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.userName is string && data.userName.size() <= 100 &&
             data.text is string && data.text.size() <= 1000 &&
             data.createdAt == request.time &&
             (!data.keys().hasAny(['pollId']) || (data.pollId is string && data.pollId.size() <= 128)) &&
             (!data.keys().hasAny(['userAvatar']) || (data.userAvatar is string && data.userAvatar.size() <= 500)) &&
             (!data.keys().hasAny(['likes']) || (data.likes is list && data.likes.size() <= 1000)) &&
             (!data.keys().hasAny(['dislikes']) || (data.dislikes is list && data.dislikes.size() <= 1000));
    }

    function isValidCommentUpdate(incoming, existing) {
      return incoming.id == existing.id &&
             incoming.userId == existing.userId &&
             incoming.userName == existing.userName &&
             incoming.text == existing.text &&
             incoming.createdAt == existing.createdAt &&
             incoming.get('pollId', null) == existing.get('pollId', null) &&
             incoming.get('userAvatar', null) == existing.get('userAvatar', null) &&
             (!incoming.keys().hasAny(['likes']) || (incoming.likes is list && incoming.likes.size() <= 1000)) &&
             (!incoming.keys().hasAny(['dislikes']) || (incoming.dislikes is list && incoming.dislikes.size() <= 1000));
    }

    function isValidAd(data) {
      return data.keys().hasAll(['id', 'imageUrl', 'link', 'title']) &&
             data.id is string && data.id.size() <= 128 &&
             data.imageUrl is string && data.imageUrl.size() <= 1000 &&
             data.link is string && data.link.size() <= 1000 &&
             data.title is string && data.title.size() <= 200 &&
             (!data.keys().hasAny(['description']) || (data.description is string && data.description.size() <= 500));
    }

    function isValidNews(data) {
      return data.keys().hasAll(['id', 'title', 'content', 'imageUrl', 'createdAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 2000 &&
             data.imageUrl is string && data.imageUrl.size() <= 1000 &&
             data.createdAt == request.time &&
             (!data.keys().hasAny(['category']) || (data.category is string && data.category.size() <= 100));
    }

    // Polls
    match /polls/{pollId} {
      allow get: if true;
      allow list: if true;
      
      // Allow creation for seeding (can be restricted to admin later)
      allow create: if isSignedIn();
      
      // Only system/admin can change metadata usually. 
      // Users can only increment totalVotes if they also create a userVote record.
      allow update: if isSignedIn() && 
                    (
                      // If it's a metadata update (like status), require admin (for now just allow if seeding/valid)
                      isValidPoll(request.resource.data)
                    ) && (
                      // Action: User Vote Increment
                      (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalVotes']) &&
                        request.resource.data.totalVotes == resource.data.totalVotes + 1 &&
                        existsAfter(/databases/$(database)/documents/userVotes/$(pollId + "_" + request.auth.uid))
                      ) || 
                      // Action: Metadata Edit (Admin-like)
                      (
                         request.resource.data.diff(resource.data).affectedKeys().hasAny(['question', 'status', 'imageUrl', 'category'])
                         // Add Admin check here if needed
                      )
                    );
    }

    // Options subcollection
    match /polls/{pollId}/options/{optionId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      
      // Users can only increment votes if they also create a userVote record pointing to this option
      allow update: if isSignedIn() && 
                    isValidOption(request.resource.data) && (
                      (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']) &&
                        request.resource.data.votes == resource.data.votes + 1 &&
                        existsAfter(/databases/$(database)/documents/userVotes/$(pollId + "_" + request.auth.uid)) &&
                        getAfter(/databases/$(database)/documents/userVotes/$(pollId + "_" + request.auth.uid)).data.optionId == optionId
                      ) ||
                      (
                        request.resource.data.diff(resource.data).affectedKeys().hasAny(['label', 'imageUrl'])
                      )
                    );
    }

    // User Votes
    match /userVotes/{voteId} {
      // allow get if document doesn't exist (to check if user already voted)
      allow get: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && 
                    voteId == request.resource.data.pollId + '_' + request.auth.uid &&
                    isValidUserVote(request.resource.data, request.resource.data.pollId);
    }

    // Comments
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(commentId) && isValidComment(request.resource.data);
      allow update: if isSignedIn() && 
                    isValidCommentUpdate(request.resource.data, resource.data) &&
                    request.resource.data.diff(resource.data).affectedKeys().hasAny(['likes', 'dislikes']) &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'dislikes']);
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid);
    }

    // Ads
    match /ads/{adId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(adId) && isValidAd(request.resource.data);
    }

    // News
    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(newsId) && isValidNews(request.resource.data);
    }
  }
}
